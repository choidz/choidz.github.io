---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogSidebar from "../components/BlogSidebar.astro";
import { formatDate, getPostUrl, sortPosts } from "../lib/posts.js";
import "../styles/korean-blog.css";
const postModules = import.meta.glob("../content/blog/*.md", { eager: true });
const posts = sortPosts(Object.values(postModules));
function raw(post) { return typeof post.rawContent === "function" ? post.rawContent() : post.rawContent ?? post.body ?? ""; }
function image(post) { return post.frontmatter.image ?? raw(post).match(/!\[[^\]]*\]\((\/images\/posts\/[^)\s]+)\)/)?.[1] ?? ""; }
---
<BaseLayout title="CHOI.DEV | 최성현의 기술 블로그" description="운영, 자동화, Linux와 모니터링 경험을 기록하는 개발 블로그입니다." pageClass="korean-blog-page">
  <main class="kblog-shell">
    <BlogSidebar posts={posts} />
    <section class="kblog-main" id="articles">
      <div class="kblog-list-head"><h2>전체 글</h2><p id="kblog-result">최신순으로 {posts.length}개의 글</p></div>
      <div class="kblog-post-list">
        {posts.map((post, index) => {
          const thumb = image(post); const category = post.frontmatter.tags?.[0] ?? "Engineering";
          return <article class="kblog-post" data-post data-tags={(post.frontmatter.tags ?? []).join(" ").toLowerCase()} data-search={`${post.frontmatter.title} ${post.frontmatter.description}`.toLowerCase()} data-index={index}>
            <a href={getPostUrl(post.frontmatter.slug)}><div class="kblog-post-copy"><div class="kblog-post-meta"><span>{category}</span><time datetime={post.frontmatter.date}>{formatDate(post.frontmatter.date)}</time><b>{post.frontmatter.readingMinutes}분</b></div><h3>{post.frontmatter.title}</h3><p>{post.frontmatter.description}</p><div class="kblog-post-tags">{(post.frontmatter.tags ?? []).slice(0, 3).map((tag) => <span>#{tag}</span>)}</div></div>{thumb && <img class="kblog-post-thumb" src={thumb} alt="" loading="lazy" />}</a>
          </article>;
        })}
      </div>
      <button class="kblog-more" id="kblog-more" type="button">글 더보기 <span aria-hidden="true">↓</span></button><p class="kblog-empty" id="kblog-empty" hidden>검색 결과가 없습니다.</p>
    </section>
  </main>
  <script>
    const posts = Array.from(document.querySelectorAll("[data-post]"));
    const search = document.querySelector("#kblog-search");
    const categories = Array.from(document.querySelectorAll("[data-category]"));
    const result = document.querySelector("#kblog-result"); const more = document.querySelector("#kblog-more"); const empty = document.querySelector("#kblog-empty");
    const params = new URLSearchParams(location.search); let category = params.get("category") || ""; let visibleLimit = 12;
    if (search && params.get("q")) search.value = params.get("q") || "";
    categories.forEach((item) => item.classList.toggle("active", (item.dataset.category || "") === category));
    function render() {
      const query = (search?.value || "").trim().toLowerCase();
      const matched = posts.filter((post) => (!category || (post.dataset.tags || "").includes(category)) && (!query || `${post.dataset.search} ${post.dataset.tags}`.includes(query)));
      posts.forEach((post) => post.hidden = true); matched.slice(0, visibleLimit).forEach((post) => post.hidden = false);
      if (result) result.textContent = `${matched.length}개의 글을 찾았습니다`; if (more) more.hidden = matched.length <= visibleLimit; if (empty) empty.hidden = matched.length !== 0;
    }
    search?.addEventListener("input", () => { visibleLimit = 12; render(); });
    categories.forEach((button) => button.addEventListener("click", () => { category = button.dataset.category || ""; visibleLimit = 12; categories.forEach((item) => item.classList.toggle("active", item === button)); render(); document.querySelector("#articles")?.scrollIntoView({ behavior:"smooth", block:"start" }); }));
    more?.addEventListener("click", () => { visibleLimit += 12; render(); }); render();
  </script>
</BaseLayout>
