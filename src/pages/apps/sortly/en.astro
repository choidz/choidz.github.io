---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const storeUrl = "https://apps.microsoft.com/detail/9nvc2q1z7361?hl=en-US&gl=US&cid=github_pages_sortly_en";
const screenshots = "/images/apps/sortly/en";

const faqs = [
  {
    question: "Will Sortly move files without asking?",
    answer: "No. You can preview every destination before organizing. Afterward, you can restore the entire cleanup to the original locations.",
  },
  {
    question: "Does Sortly send my files outside my PC?",
    answer: "Standard organization, rules, duplicate checks, and folder insights run on your PC. Cloud AI is used only when you choose it and consent. Image and music contents are not sent for cloud document analysis.",
  },
  {
    question: "Can I use Sortly for free?",
    answer: "Yes. Manual organization, previews, undo, duplicate checks, and automation for one folder are free. Pro adds multi-folder automation, schedules, and other advanced tools.",
  },
  {
    question: "Which versions of Windows are supported?",
    answer: "Sortly is available through Microsoft Store for Windows 10 and Windows 11, with English and Korean interfaces.",
  },
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Sortly",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Windows 10, Windows 11",
  description: "A Windows file organizer that safely cleans Downloads and work folders with previews, rules, duplicate detection, and one-click undo.",
  url: "https://choidz.github.io/apps/sortly/en",
  downloadUrl: storeUrl,
  inLanguage: "en",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  featureList: [
    "Preview before organizing",
    "Automatic sorting by file type and name rules",
    "Duplicate file detection",
    "One-click cleanup undo",
    "Automatic folder monitoring",
    "AI-assisted organization",
  ],
};
---

<BaseLayout
  title="Sortly | Automatic File Organizer for Windows"
  description="Automatically organize Downloads and work folders. Preview every move, find duplicates, and undo an entire cleanup anytime."
  image="/images/apps/sortly/og-sortly.png"
  canonical="/apps/sortly/en"
  hideHeader={true}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(softwareSchema)}></script>

  <div class="sortly-page">
    <header class="product-header">
      <div class="product-nav">
        <a class="product-brand" href="/apps/sortly/en" aria-label="Sortly home">
          <img src="/images/apps/sortly/icon-128.png" width="38" height="38" alt="" />
          <span>Sortly</span>
        </a>
        <nav aria-label="Sortly page menu">
          <a href="#features">Features</a>
          <a href="#safety">Safety</a>
          <a href="#plans">Plans</a>
          <a href="/apps/sortly" lang="ko">한국어</a>
          <a class="nav-cta" href={storeUrl} target="_blank" rel="noreferrer" data-store-cta="nav">Install free</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero section-shell">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Windows 10·11 · Microsoft Store</p>
          <h1>Your Downloads,<br /><strong>organized automatically.</strong></h1>
          <p class="hero-lead">Sortly watches for new files and sorts them using your rules. Preview every move first, and undo the entire cleanup if you change your mind.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={storeUrl} target="_blank" rel="noreferrer" data-store-cta="hero">
              Install free from Microsoft Store
              <span aria-hidden="true">↗</span>
            </a>
            <a class="button button-secondary" href="#how-it-works">See how it works</a>
          </div>
          <ul class="hero-notes" aria-label="Product details">
            <li>No account required</li>
            <li>English and Korean</li>
            <li>Automatic updates</li>
          </ul>
        </div>

        <div class="hero-visual">
          <div class="window-glow"></div>
          <figure class="app-window app-window-main">
            <img src={`${screenshots}/01-main.png`} width="1366" height="768" alt="Sortly main window showing files in the Downloads folder" />
          </figure>
          <div class="floating-card floating-card-top">
            <span class="status-dot"></span>
            <div><strong>Auto organize ready</strong><small>Waiting for new files</small></div>
          </div>
          <div class="floating-card floating-card-bottom">
            <strong>Preview, then organize</strong><span aria-hidden="true">→</span>
          </div>
        </div>
      </section>

      <section class="trust-strip" aria-label="Sortly principles">
        <div class="section-shell trust-grid">
          <div><strong>Preview first</strong><span>See every destination before moving</span></div>
          <div><strong>Undo anytime</strong><span>Restore a complete cleanup</span></div>
          <div><strong>Your rules</strong><span>Sort by type and name keywords</span></div>
          <div><strong>AI when you choose</strong><span>Used only after your consent</span></div>
        </div>
      </section>

      <section id="how-it-works" class="workflow section-shell">
        <div class="section-heading centered">
          <p class="eyebrow">Just three steps</p>
          <h2>Clean up quickly.<br />Stay in control.</h2>
          <p>Choose a folder, review the result, and organize. Sortly keeps every decision visible before files move.</p>
        </div>
        <ol class="workflow-grid">
          <li><span>01</span><strong>Choose a folder</strong><p>Select Downloads or any work folder you want to clean up.</p></li>
          <li><span>02</span><strong>Review every move</strong><p>See which files will go to each destination.</p></li>
          <li><span>03</span><strong>Organize or undo</strong><p>Clean everything at once and restore the whole job when needed.</p></li>
        </ol>
      </section>

      <section id="features" class="feature-stack">
        <article class="feature-row section-shell">
          <div class="feature-copy">
            <p class="eyebrow">Preview first</p>
            <h2>See the result<br />before files move.</h2>
            <p>Review the files and destinations in each category. If something important appears, adjust your rules before you run the cleanup.</p>
            <ul class="check-list">
              <li>Automatic sorting by file type</li>
              <li>Name keywords and custom rules</li>
              <li>Size, age, and excluded-folder filters</li>
            </ul>
          </div>
          <figure class="feature-shot">
            <img src={`${screenshots}/02-organize-preview.png`} width="1366" height="768" loading="lazy" alt="Sortly preview showing files and their destination folders" />
          </figure>
        </article>

        <article class="feature-row feature-row-reverse section-shell">
          <div class="feature-copy">
            <p class="eyebrow">Smart automation</p>
            <h2>Turn repeated cleanup<br />into reusable rules.</h2>
            <p>Sortly analyzes a folder without moving anything, then suggests repeated patterns and time-saving automation. You decide what to apply.</p>
            <ul class="check-list">
              <li>Files ready for automation and suggested groups</li>
              <li>Custom rules for documents and screenshots</li>
              <li>Multi-folder automation and schedules <em>Pro</em></li>
            </ul>
          </div>
          <figure class="feature-shot">
            <img src={`${screenshots}/04-automation-preview.png`} width="1366" height="768" loading="lazy" alt="Sortly automation preview with suggested groups and rules" />
          </figure>
        </article>

        <article class="feature-row section-shell">
          <div class="feature-copy">
            <p class="eyebrow">Clean with confidence</p>
            <h2>Find duplicates.<br />Undo mistakes.</h2>
            <p>Sortly compares file sizes and contents to find true duplicates. Removed files go to the Recycle Bin, and a complete cleanup can be restored as one job.</p>
            <ul class="check-list">
              <li>Scan subfolders for duplicates</li>
              <li>Show the largest duplicate groups first</li>
              <li>Undo an entire cleanup in one click</li>
            </ul>
          </div>
          <div class="feature-gallery" aria-label="Duplicate detection and cleanup undo screens">
            <figure class="feature-shot">
              <img src={`${screenshots}/03-duplicates.png`} width="1366" height="768" loading="lazy" alt="Duplicate files grouped by matching content" />
              <figcaption><span>01</span> Find duplicate files</figcaption>
            </figure>
            <figure class="feature-shot">
              <img src={`${screenshots}/05-undo.png`} width="1366" height="768" loading="lazy" alt="Restore a file cleanup to the original locations" />
              <figcaption><span>02</span> Undo a complete cleanup</figcaption>
            </figure>
          </div>
        </article>

        <article class="feature-row feature-row-reverse section-shell">
          <div class="feature-copy">
            <p class="eyebrow">Pro control center</p>
            <h2>Manage every folder<br />from one place.</h2>
            <p>With Pro, start and manage per-folder automation, insights, AI cleanup, and scheduled jobs from one control center.</p>
            <ul class="check-list">
              <li>Multiple watched folders with individual pause controls</li>
              <li>Daily, weekly, and monthly schedules</li>
              <li>Folder insights and local safety checks</li>
            </ul>
          </div>
          <figure class="feature-shot">
            <img src={`${screenshots}/06-pro-panel.png`} width="1366" height="768" loading="lazy" alt="Sortly Pro control center for automation, insights, AI cleanup, and schedules" />
          </figure>
        </article>
      </section>

      <section id="safety" class="safety-section">
        <div class="section-shell safety-grid">
          <div class="safety-copy">
            <p class="eyebrow light">Local-first</p>
            <h2>Your file organization<br />starts on your PC.</h2>
            <p>Standard organization, rules, duplicate checks, and folder insights run locally. Cloud AI is used only when you choose the feature and consent.</p>
            <a href="/privacy-policy/sortly-en.html">Read the privacy policy <span aria-hidden="true">→</span></a>
          </div>
          <div class="safety-points">
            <article><span>01</span><strong>No account required</strong><p>Install and start without creating an account or signing in.</p></article>
            <article><span>02</span><strong>Local history</strong><p>Your rules and move history stay on your device by default.</p></article>
            <article><span>03</span><strong>AI is optional</strong><p>Image and music contents are not sent for cloud document analysis.</p></article>
            <article><span>04</span><strong>Analytics is optional</strong><p>Usage analytics is off by default and sent only when you enable it.</p></article>
          </div>
        </div>
      </section>

      <section id="plans" class="plans section-shell">
        <div class="section-heading centered">
          <p class="eyebrow">Start free</p>
          <h2>Start free.<br />Choose Pro when you need more automation.</h2>
        </div>
        <div class="plan-grid">
          <article class="plan-card">
            <div><p>Free</p><h3>Everything you need for safe file cleanup</h3><span>Free</span></div>
            <ul>
              <li>Manual organization with previews</li>
              <li>Duplicate file detection</li>
              <li>Whole-job undo</li>
              <li>Automatic organization for one folder</li>
              <li>Try AI cleanup on 20 files</li>
            </ul>
            <a class="button button-secondary full" href={storeUrl} target="_blank" rel="noreferrer" data-store-cta="free-plan">Install free</a>
          </article>
          <article class="plan-card plan-card-pro">
            <div><p>Pro</p><h3>Automation for recurring cleanup</h3><span>Microsoft Store subscription</span></div>
            <ul>
              <li>Automate multiple folders at once</li>
              <li>Pause and manage each folder separately</li>
              <li>Scheduled cleanup and old-file archiving</li>
              <li>Folder insights and local safety analysis</li>
              <li>1,000 AI cleanups each month</li>
            </ul>
            <a class="button button-primary full" href={storeUrl} target="_blank" rel="noreferrer" data-store-cta="pro-plan">View Pro in the app</a>
          </article>
        </div>
      </section>

      <section class="faq section-shell">
        <div class="section-heading faq-heading">
          <p class="eyebrow">FAQ</p>
          <h2>Questions before<br />you install</h2>
        </div>
        <div class="faq-list">
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}<span aria-hidden="true">+</span></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="final-cta section-shell">
        <div>
          <p class="eyebrow light">Your folders, on autopilot</p>
          <h2>Start with the files<br />you downloaded today.</h2>
          <p>Install Sortly free from Microsoft Store and preview your first cleanup.</p>
        </div>
        <a class="button button-white" href={storeUrl} target="_blank" rel="noreferrer" data-store-cta="final">
          Install Sortly free <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>

    <footer class="product-footer">
      <div class="section-shell footer-inner">
        <div class="footer-brand"><img src="/images/apps/sortly/icon-128.png" width="32" height="32" alt="" /><strong>Sortly</strong><span>Automatic file organization for Windows</span></div>
        <nav aria-label="Sortly links">
          <a href="/apps/sortly">한국어</a>
          <a href="/apps/sortly/support">Support</a>
          <a href="/privacy-policy/sortly-en.html">Privacy policy</a>
          <a href="/privacy-policy/sortly-terms-en.html">Terms of use</a>
          <a href="/">Developer blog</a>
        </nav>
        <p>© 2026 choioki. Available from Microsoft Store.</p>
      </div>
    </footer>
  </div>

  <script>
    document.querySelectorAll("[data-store-cta]").forEach((link) => {
      link.addEventListener("click", () => {
        const source = link.getAttribute("data-store-cta") || "unknown";
        if (typeof window.gtag === "function") {
          window.gtag("event", "sortly_store_click", { source });
        }
      });
    });
  </script>
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; background: #f6f9ff; }
  :global(body) { background: #f6f9ff; }
  :global(.sortly-page) { --blue: #1578f2; --blue-dark: #075bc4; --ink: #111827; --muted: #58657a; --line: #dfe7f2; color: var(--ink); background: #fff; overflow: hidden; }
  .section-shell { width: min(1180px, calc(100% - 48px)); margin-inline: auto; }
  .product-header { position: relative; z-index: 50; border-bottom: 1px solid rgba(216, 226, 239, .75); background: rgba(255,255,255,.88); backdrop-filter: blur(18px); }
  .product-nav { display: flex; width: min(1180px, calc(100% - 48px)); min-height: 76px; align-items: center; justify-content: space-between; gap: 24px; margin-inline: auto; }
  .product-brand { display: inline-flex; align-items: center; gap: 11px; font-size: 21px; font-weight: 850; letter-spacing: -.03em; }
  .product-brand img { border-radius: 9px; box-shadow: 0 8px 20px rgba(21, 120, 242, .2); }
  .product-nav nav { display: flex; align-items: center; gap: 8px; color: #435066; font-size: 14px; font-weight: 720; }
  .product-nav nav a { padding: 10px 13px; border-radius: 999px; }
  .product-nav nav a:hover { color: var(--blue); background: #f0f6ff; }
  .product-nav nav .nav-cta { margin-left: 8px; padding-inline: 18px; color: #fff; background: var(--blue); }
  .product-nav nav .nav-cta:hover { color: #fff; background: var(--blue-dark); }
  .hero { display: grid; grid-template-columns: minmax(0, .88fr) minmax(560px, 1.12fr); gap: clamp(46px, 6vw, 88px); align-items: center; min-height: 760px; padding-block: 86px 104px; }
  .eyebrow { margin: 0 0 18px; color: var(--blue); font-size: 13px; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .eyebrow > span { display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 5px rgba(34,197,94,.12); vertical-align: 1px; }
  .hero h1 { margin: 0; color: var(--ink); font-size: clamp(48px, 5.5vw, 72px); font-weight: 880; letter-spacing: -.055em; line-height: 1.08; word-break: keep-all; }
  .hero h1 strong { color: var(--blue); font-weight: inherit; }
  .hero-lead { max-width: 610px; margin: 28px 0 0; color: var(--muted); font-size: 19px; line-height: 1.8; word-break: keep-all; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .button { display: inline-flex; min-height: 52px; align-items: center; justify-content: center; gap: 12px; border: 1px solid transparent; border-radius: 14px; padding: 0 22px; font-size: 15px; font-weight: 800; transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease; }
  .button:hover { transform: translateY(-2px); }
  .button-primary { color: #fff; background: var(--blue); box-shadow: 0 14px 30px rgba(21,120,242,.22); }
  .button-primary:hover { background: var(--blue-dark); box-shadow: 0 18px 36px rgba(21,120,242,.28); }
  .button-secondary { border-color: #dce5f1; color: #263348; background: #fff; }
  .button-secondary:hover { border-color: #b8c8dc; box-shadow: 0 12px 28px rgba(25,45,75,.09); }
  .hero-notes { display: flex; flex-wrap: wrap; gap: 22px; margin: 24px 0 0; padding: 0; color: #768298; font-size: 13px; font-weight: 700; list-style: none; }
  .hero-notes li::before { content: "✓"; margin-right: 7px; color: #16a34a; font-weight: 900; }
  .hero-visual { position: relative; min-height: 520px; }
  .window-glow { position: absolute; inset: 0 -15% -12% 5%; border-radius: 50%; background: radial-gradient(circle, rgba(21,120,242,.26), rgba(89,157,255,.06) 52%, transparent 70%); filter: blur(30px); }
  .app-window { position: absolute; z-index: 2; overflow: hidden; margin: 0; border: 1px solid #cbd8e8; border-radius: 18px; background: #fff; box-shadow: 0 32px 90px rgba(31, 67, 118, .25), 0 8px 24px rgba(31, 67, 118, .12); }
  .app-window img { display: block; width: 100%; height: auto; aspect-ratio: 1366 / 768; object-fit: contain; }
  .app-window-main { top: 42px; right: -138px; width: 780px; aspect-ratio: 1366 / 768; }
  .floating-card { position: absolute; z-index: 3; display: flex; align-items: center; border: 1px solid rgba(210,222,238,.9); border-radius: 15px; color: #1d2a3f; background: rgba(255,255,255,.94); box-shadow: 0 18px 42px rgba(35,69,115,.18); backdrop-filter: blur(14px); }
  .floating-card-top { top: 6px; left: 5px; gap: 11px; padding: 13px 16px; }
  .floating-card-top div { display: grid; gap: 2px; }
  .floating-card strong { font-size: 13px; }
  .floating-card small { color: #7a879a; font-size: 11px; }
  .status-dot { width: 10px; height: 10px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 5px rgba(34,197,94,.12); }
  .floating-card-bottom { right: -22px; bottom: 10px; gap: 16px; padding: 15px 18px; color: #fff; background: rgba(10, 31, 66, .94); }
  .trust-strip { border-block: 1px solid #e2e9f2; background: #f8fbff; }
  .trust-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .trust-grid div { display: grid; gap: 5px; padding: 26px 24px; border-right: 1px solid #e2e9f2; }
  .trust-grid div:first-child { border-left: 1px solid #e2e9f2; }
  .trust-grid strong { font-size: 15px; }
  .trust-grid span { color: #718096; font-size: 12px; }
  .workflow { padding-block: 132px; }
  .section-heading { max-width: 680px; }
  .section-heading.centered { margin-inline: auto; text-align: center; }
  .section-heading h2, .feature-copy h2, .safety-copy h2, .faq-heading h2, .final-cta h2 { margin: 0; font-size: clamp(38px, 4.8vw, 58px); font-weight: 870; letter-spacing: -.045em; line-height: 1.13; word-break: keep-all; }
  .section-heading > p:last-child { margin: 22px auto 0; color: var(--muted); font-size: 18px; line-height: 1.8; word-break: keep-all; }
  .workflow-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin: 64px 0 0; padding: 0; counter-reset: steps; list-style: none; }
  .workflow-grid li { position: relative; min-height: 220px; border: 1px solid var(--line); border-radius: 22px; padding: 28px; background: linear-gradient(145deg, #fff, #f7faff); }
  .workflow-grid li::after { content: ""; position: absolute; top: 51px; right: -28px; z-index: 2; width: 38px; height: 1px; background: #cbd8e8; }
  .workflow-grid li:last-child::after { display: none; }
  .workflow-grid span { display: grid; width: 44px; height: 44px; place-items: center; border-radius: 13px; color: var(--blue); background: #eaf3ff; font-size: 13px; font-weight: 900; }
  .workflow-grid strong { display: block; margin-top: 28px; font-size: 21px; }
  .workflow-grid p { margin: 10px 0 0; color: var(--muted); line-height: 1.7; }
  .feature-stack { border-top: 1px solid #e7edf5; background: #f7faff; }
  .feature-row { display: grid; grid-template-columns: .82fr 1.18fr; gap: clamp(50px, 8vw, 110px); align-items: center; padding-block: 118px; border-bottom: 1px solid #e1e9f3; }
  .feature-row-reverse { grid-template-columns: 1.18fr .82fr; }
  .feature-row-reverse .feature-copy { order: 2; }
  .feature-row-reverse > .feature-shot { order: 1; }
  .feature-copy h2 { font-size: clamp(38px, 4.2vw, 54px); }
  .feature-copy > p:not(.eyebrow) { margin: 24px 0 0; color: var(--muted); font-size: 17px; line-height: 1.85; word-break: keep-all; }
  .check-list { display: grid; gap: 12px; margin: 28px 0 0; padding: 0; list-style: none; }
  .check-list li { color: #314057; font-size: 15px; font-weight: 720; }
  .check-list li::before { content: "✓"; display: inline-grid; width: 22px; height: 22px; margin-right: 10px; place-items: center; border-radius: 50%; color: var(--blue); background: #e4f0ff; font-size: 12px; font-weight: 900; }
  .check-list em { margin-left: 5px; border-radius: 999px; padding: 3px 7px; color: #fff; background: var(--blue); font-size: 10px; font-style: normal; letter-spacing: .04em; }
  .feature-shot { overflow: hidden; margin: 0; border: 1px solid #cfdae9; border-radius: 20px; background: #fff; box-shadow: 0 30px 70px rgba(31, 67, 118, .17); }
  .feature-shot img { display: block; width: 100%; height: auto; aspect-ratio: 1366 / 768; object-fit: contain; }
  .feature-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .feature-gallery .feature-shot { border-radius: 16px; box-shadow: 0 22px 50px rgba(31, 67, 118, .13); }
  .feature-gallery figcaption { display: flex; align-items: center; gap: 10px; border-top: 1px solid #e4ebf4; padding: 14px 16px; color: #26364e; font-size: 14px; font-weight: 820; }
  .feature-gallery figcaption span { display: inline-grid; width: 28px; height: 28px; place-items: center; border-radius: 9px; color: var(--blue); background: #eaf3ff; font-size: 11px; }
  .safety-section { color: #fff; background: #0c1830; }
  .safety-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(60px, 10vw, 140px); padding-block: 124px; }
  .eyebrow.light { color: #72b0ff; }
  .safety-copy p:not(.eyebrow) { margin: 28px 0 0; color: #aebbd0; font-size: 17px; line-height: 1.85; }
  .safety-copy a { display: inline-flex; gap: 12px; margin-top: 28px; color: #d7e8ff; font-weight: 800; }
  .safety-copy a:hover { color: #fff; }
  .safety-points { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid rgba(160,183,218,.22); border-left: 1px solid rgba(160,183,218,.22); }
  .safety-points article { min-height: 210px; border-right: 1px solid rgba(160,183,218,.22); border-bottom: 1px solid rgba(160,183,218,.22); padding: 26px; }
